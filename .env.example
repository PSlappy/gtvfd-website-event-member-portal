# Instagram Graph API (stage 3 — home page carousel)
#
# Setup: Meta developer app + Instagram Business/Creator account linked
# to a Facebook Page. See the stage 3 notes in CLAUDE.md for the full
# walkthrough. Never commit the real values — copy this file to
# .env.local (already gitignored) and fill them in there.

# Long-lived access token (60-day, needs periodic refresh)
INSTAGRAM_ACCESS_TOKEN=

# The Instagram Business Account ID linked to the Facebook Page
INSTAGRAM_BUSINESS_ACCOUNT_ID=
